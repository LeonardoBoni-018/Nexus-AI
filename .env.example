# Copie para .env (nao versionado) e ajuste. Nenhum valor abaixo e um segredo real.

# --- Banco (docker compose) ---
DB_PASSWORD=troque-esta-senha-local

# --- Comportamento ---
DEMO_SEED=true              # cria organizacoes/usuarios/dados DEMONSTRATIVOS se o banco estiver vazio
REGISTRATION_ENABLED=false  # cadastro publico de usuarios
COOKIE_SECURE=false         # true em producao (HTTPS)
REQUIRE_SEPARATE_APPROVER=false # true = quem criou a proposta nao pode aprova-la
METRICS_TOKEN=              # habilita /actuator/prometheus com o header X-Metrics-Token (vazio = bloqueado)

# --- IA (opcional; sem isso o assistente informa que precisa ser configurado) ---
AI_PROVIDER=                # anthropic | openai (OpenAI e servidores compativeis via AI_BASE_URL)
AI_MODEL=                   # ex.: id do modelo do provedor escolhido
AI_API_KEY=
AI_BASE_URL=
# AI_MAX_TOOL_CALLS=8
# AI_REQUEST_TIMEOUT=60s
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_CONVERSATION_HISTORY=20
# AI_RATE_LIMIT_PER_MINUTE=20

# --- Backend sem Docker ---
# DB_URL=jdbc:postgresql://localhost:5432/nexus
# DB_USER=nexus
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# OPENAPI_ENABLED=false
